---
/**
 * Route explorer (Akari IP-03 selector + IP-05 comparison). The three route
 * options are a native radio group; each option carries a mini line drawn to
 * the shared time scale, so the options compare at a glance. The focused route
 * opens below with its full journey line, facts and reasons.
 *
 * Works without JavaScript: selection is CSS (:has). Browsers without :has
 * show every route's detail, which is still complete.
 */
import ExternalLink from "../app/ExternalLink.astro";
import Icon from "../app/Icon.astro";
import JourneyLine from "./JourneyLine.astro";
import FareScale from "./FareScale.astro";
import Freshness from "../app/Freshness.astro";
import { flightGuidance, flightRoutes } from "../../data/travel";

const scaleMinutes = Math.max(
  ...flightRoutes.map((r) => r.legs.reduce((sum, leg) => sum + leg.minutes, 0)),
);
const gbp = (v: number) => `£${v.toLocaleString("en-GB")}`;
---

<div class="routes" data-routes>
  <div class="card budget">
    <div class="budget__head">
      <div>
        <p class="budget__label">Economy return, per person</p>
        <p class="budget__value num">
          {gbp(flightGuidance.budget.low)}–{gbp(flightGuidance.budget.high)}
        </p>
      </div>
      <Freshness />
    </div>
    <FareScale />
    <p class="note">{flightGuidance.budgetNote}</p>
  </div>

  <fieldset class="route-options">
    <legend class="route-options__legend">Three good ways from London</legend>
    <div class="route-options__list">
      {
        flightRoutes.map((route) => (
          <>
            <input
              class="route-options__input"
              type="radio"
              name="route"
              id={`route-${route.id}`}
              value={route.id}
              checked={route.featured}
            />
            <label class="route-option" for={`route-${route.id}`}>
              <span class="route-option__top">
                <span class="route-option__hub">Via {route.hub}</span>
                {route.featured && <span class="chip chip--lagoon">Suggested</span>}
              </span>
              <span class="route-option__airline">{route.airline}</span>
              <JourneyLine route={route} scaleMinutes={scaleMinutes} size="mini" />
              <span class="route-option__facts">
                <span class="num">{route.journeyShort}</span>
                <span class="num">from {gbp(route.fareFrom)}</span>
              </span>
            </label>
          </>
        ))
      }
    </div>
  </fieldset>

  <div class="route-panels">
    {
      flightRoutes.map((route) => (
        <article
          class="card route-panel"
          data-route-panel={route.id}
          aria-labelledby={`route-title-${route.id}`}
        >
          <header class="route-panel__head">
            <p class="route-panel__eyebrow">{route.title}</p>
            <h3 class="route-panel__title" id={`route-title-${route.id}`}>
              London <Icon name="arrow-right" size={20} /> {route.hub}{" "}
              <Icon name="arrow-right" size={20} /> Cebu
            </h3>
            <p class="route-panel__airline">with {route.airline}</p>
          </header>

          <JourneyLine route={route} scaleMinutes={scaleMinutes} />

          <dl class="stats">
            <div class="stat">
              <dt>Journey</dt>
              <dd class="num">{route.journey}</dd>
            </div>
            <div class="stat">
              <dt>Fares from</dt>
              <dd class="num">about {gbp(route.fareFrom)}</dd>
              <dd class="stat__sub">{route.fareNote}</dd>
            </div>
            <div class="stat">
              <dt>Flights</dt>
              <dd>From {route.londonAirports}</dd>
              <dd class="stat__sub">{route.frequency}</dd>
            </div>
          </dl>

          <p class="route-panel__why">{route.why}</p>

          <div class="route-panel__actions">
            <ExternalLink href={route.link.href} site={route.link.site} variant="primary">
              {route.link.label}
            </ExternalLink>
            <ExternalLink
              href={flightGuidance.compare.href}
              site={flightGuidance.compare.site}
              variant="secondary"
            >
              Compare on Google Flights
            </ExternalLink>
          </div>
        </article>
      ))
    }
  </div>

  <div class="callout">
    <Icon name="info" size={20} />
    <p>
      {flightGuidance.noDirect}{" "}
      {flightGuidance.notYetOnSale} Lines are drawn to scheduled flying time; time changing planes varies
      by day.
    </p>
  </div>
</div>
