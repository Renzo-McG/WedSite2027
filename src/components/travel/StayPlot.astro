---
/**
 * Orientation plot for Where to stay. Positions come from each place's real
 * coordinates (src/data/travel.ts), projected to scale. There is no drawn
 * coastline or road: the plot shows how far apart things are, and hands off
 * to Google Maps for anything more.
 */
import { landmarks, stays } from "../../data/travel";
import { UNITS_PER_KM, distanceKm, frameFor, toKm, toPercent } from "../../lib/travel-plot";

const venue = stays.find((stay) => stay.isVenue)!;
const frame = frameFor([...stays.map((stay) => stay.location), landmarks.airport.location], 0.9);

const width = frame.widthKm * UNITS_PER_KM;
const height = frame.heightKm * UNITS_PER_KM;
const scale = (point: { lat: number; lng: number }) => {
  const { x, y } = toKm(frame, point);
  return { x: x * UNITS_PER_KM, y: y * UNITS_PER_KM };
};

const venuePoint = scale(venue.location);
const airportPoint = scale(landmarks.airport.location);
const airportLabel = toPercent(frame, landmarks.airport.location);
const cityTop = toPercent(frame, landmarks.cebuCity.location).top;
const cityKm = Math.round(distanceKm(landmarks.airport.location, landmarks.cebuCity.location));
const rings = [2, 4];
---

<figure class="stay-plot" data-stay-plot>
  <div class="stay-plot__canvas" style={`aspect-ratio: ${width.toFixed(0)} / ${height.toFixed(0)}`}>
    <svg
      class="stay-plot__svg"
      viewBox={`0 0 ${width.toFixed(0)} ${height.toFixed(0)}`}
      aria-hidden="true"
      focusable="false"
    >
      <defs>
        <clipPath id="stay-plot-clip">
          <rect width={width} height={height}></rect>
        </clipPath>
      </defs>
      <g clip-path="url(#stay-plot-clip)">
        {
          rings.map((km) => (
            <circle
              class="stay-plot__ring"
              cx={venuePoint.x}
              cy={venuePoint.y}
              r={km * UNITS_PER_KM}
            />
          ))
        }
        <line
          class="stay-plot__arrival"
          x1={airportPoint.x}
          y1={airportPoint.y}
          x2={venuePoint.x}
          y2={venuePoint.y}></line>
      </g>
      <rect
        class="stay-plot__airport"
        x={airportPoint.x - 9}
        y={airportPoint.y - 9}
        width="18"
        height="18"
        transform={`rotate(45 ${airportPoint.x} ${airportPoint.y})`}></rect>
      {
        stays.map((stay) => {
          const p = scale(stay.location);
          return stay.isVenue ? (
            <g class="stay-plot__point stay-plot__point--venue" data-stay-point={stay.id}>
              <circle cx={p.x} cy={p.y} r="22" class="stay-plot__halo" />
              <circle cx={p.x} cy={p.y} r="11" />
            </g>
          ) : (
            <g class="stay-plot__point" data-stay-point={stay.id}>
              <circle cx={p.x} cy={p.y} r="22" class="stay-plot__halo" />
              <circle cx={p.x} cy={p.y} r="9" />
            </g>
          );
        })
      }
    </svg>

    <span
      class="stay-plot__label stay-plot__label--above stay-plot__label--landmark"
      style={`left: ${airportLabel.left}%; top: ${airportLabel.top}%`}
    >
      Airport
    </span>

    {
      stays.map((stay) => {
        const pos = toPercent(frame, stay.location);
        return (
          <a
            class:list={[
              "stay-plot__label",
              `stay-plot__label--${stay.label}`,
              stay.isVenue && "stay-plot__label--venue",
            ]}
            href={`#stay-${stay.id}`}
            style={`left: ${pos.left}%; top: ${pos.top}%`}
            data-stay-label={stay.id}
          >
            {stay.shortName}
            {stay.isVenue && <span class="stay-plot__venue-note">The wedding</span>}
          </a>
        );
      })
    }

    <span class="stay-plot__city" style={`top: ${cityTop}%`} aria-hidden="true">
      <svg viewBox="0 0 16 8" focusable="false"><path d="M15 4H1m3-3L1 4l3 3"></path></svg>
      Cebu City, {cityKm} km
    </span>

    <span class="stay-plot__north" aria-hidden="true">
      <svg viewBox="0 0 10 14" focusable="false"><path d="M5 1v12M1.5 4.5 5 1l3.5 3.5"></path></svg>
      N
    </span>

    <span
      class="stay-plot__scale"
      aria-hidden="true"
      style={`--scale-width: ${((UNITS_PER_KM / width) * 100).toFixed(2)}%`}
    >
      <span class="stay-plot__scale-bar"></span>
      1 km
    </span>
  </div>
  <figcaption class="stay-plot__caption">
    Places plotted to scale from their real positions on Mactan Island. The rings mark 2 km and 4 km
    from Shangri-La in a straight line. The dashed line joins the airport and the venue, 9 km apart
    by road.
  </figcaption>
</figure>
