---
/**
 * 7 / 10 / 14 day trip shapes. A native radio group drives the panels with CSS
 * alone, so the control works without JavaScript and behaves like any other
 * radio group for keyboards and screen readers. Browsers without :has() show
 * all three shapes one after another, which is still a complete answer.
 *
 * Nothing here is priced or multiplied: the shapes exist to help guests
 * imagine the trip, not to quote it.
 */
import { tripGuidance, tripShapes } from "../../data/travel";

function dayRange(start: number, days: number): string {
  return days === 1 ? `Day ${start}` : `Days ${start}–${start + days - 1}`;
}
---

<div class="trip" data-trip>
  <fieldset class="trip__control">
    <legend class="trip__legend">Choose a trip length</legend>
    <div class="trip__options">
      {
        tripShapes.map((shape) => (
          <>
            <input
              class="trip__input"
              type="radio"
              name="trip-length"
              id={`trip-${shape.days}`}
              value={shape.days}
              checked={shape.days === tripGuidance.defaultDays}
            />
            <label class="trip__option" for={`trip-${shape.days}`}>
              <span class="trip__option-days">{shape.days}</span> days
            </label>
          </>
        ))
      }
    </div>
  </fieldset>

  <div class="trip__shapes">
    {
      tripShapes.map((shape) => {
        let start = 1;
        return (
          <section
            class="trip__shape"
            data-trip-shape={shape.days}
            aria-labelledby={`trip-${shape.days}-title`}
          >
            <header class="trip__head">
              <h3 class="trip__name" id={`trip-${shape.days}-title`}>
                <span class="tas-visually-hidden">{shape.days} days: </span>
                {shape.name}
              </h3>
              <p class="trip__summary">{shape.summary}</p>
              <p class="trip__nights">{shape.nightsInCebu}</p>
            </header>

            <ol class="trip__days" style={`--trip-days: ${shape.days}`}>
              {shape.segments.map((segment) => {
                const range = dayRange(start, segment.days);
                start += segment.days;
                return (
                  <li
                    class={`trip__segment trip__segment--${segment.kind}`}
                    style={`flex-grow: ${segment.days}`}
                  >
                    <span class="trip__range">{range}</span>
                    <span class="trip__label">{segment.label}</span>
                    {segment.detail && <span class="trip__detail">{segment.detail}</span>}
                  </li>
                );
              })}
            </ol>

            <ul class="trip__ideas">
              {shape.ideas.map((idea) => (
                <li class="trip__idea">
                  <h4 class="trip__idea-title">{idea.title}</h4>
                  <p>{idea.detail}</p>
                </li>
              ))}
            </ul>
          </section>
        );
      })
    }
  </div>
</div>
