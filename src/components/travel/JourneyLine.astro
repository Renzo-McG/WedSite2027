---
/**
 * A flight route drawn to time. Leg lengths are proportional to scheduled
 * flying minutes on a scale shared by every route. When the route becomes
 * visible the line draws from London and a plane rides its leading edge
 * (transform-only; reduced motion shows it complete).
 */
import Icon from "../app/Icon.astro";
import type { FlightRoute } from "../../data/travel";

interface Props {
  route: FlightRoute;
  scaleMinutes: number;
  size?: "mini" | "full";
}

const { route, scaleMinutes, size = "full" } = Astro.props;
const flying = route.legs.reduce((sum, leg) => sum + leg.minutes, 0);
const share = ((flying / scaleMinutes) * 100).toFixed(2);
const hm = (m: number) =>
  `${Math.floor(m / 60)}h${m % 60 ? ` ${String(m % 60).padStart(2, "0")}` : ""}`;
const places = [route.legs[0]!.from, ...route.legs.map((l) => l.to)];
---

<div class:list={["journey", `journey--${size}`]} style={`--share: ${share}%`} aria-hidden="true">
  <div class="journey__track">
    <div class="journey__line">
      {
        route.legs.map((leg, i) => (
          <>
            <span class:list={["journey__node", i === 0 && "journey__node--end"]}>
              {size === "full" && <span class="journey__place">{leg.from}</span>}
            </span>
            <span class="journey__leg" style={`flex-grow: ${leg.minutes}`}>
              {size === "full" && <span class="journey__time num">{hm(leg.minutes)}</span>}
            </span>
          </>
        ))
      }
      <span class="journey__node journey__node--end">
        {size === "full" && <span class="journey__place">{places.at(-1)}</span>}
      </span>
    </div>
    <span class="journey__cover"></span>
    <span class="journey__plane-rail">
      <span class="journey__plane"><Icon name="plane" size={size === "full" ? 20 : 14} /></span>
    </span>
  </div>
</div>
