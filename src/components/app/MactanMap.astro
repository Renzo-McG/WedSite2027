---
/**
 * A to-scale map of Mactan drawn from OpenStreetMap coastline data at build
 * time (src/data/mactan-geo.ts). No tiles, no API, no key: the SVG is part of
 * the page. Children render the interactive layer (pins, labels) positioned in
 * percentages of the same frame, via the `frame` exposed on each point.
 */
import { coastline } from "../../data/mactan-geo";
import { UNITS_PER_KM, frameFor, toKm, type LatLng } from "../../lib/travel-plot";

interface Props {
  /** Points the frame must contain. */
  fit: LatLng[];
  marginKm?: number;
  class?: string;
  label: string;
}

const { fit, marginKm = 1, class: className = "", label } = Astro.props;
const frame = frameFor(fit, marginKm);
const width = Math.round(frame.widthKm * UNITS_PER_KM);
const height = Math.round(frame.heightKm * UNITS_PER_KM);

const project = (lat: number, lng: number) => {
  const { x, y } = toKm(frame, { lat, lng });
  return `${(x * UNITS_PER_KM).toFixed(1)} ${(y * UNITS_PER_KM).toFixed(1)}`;
};

const ringPath = (ring: [number, number][], close = true) =>
  ring.map(([lat, lng], i) => `${i === 0 ? "M" : "L"}${project(lat, lng)}`).join("") +
  (close ? "Z" : "");

const land = coastline.land.map((ring) => ringPath(ring)).join("");
const runway = coastline.runway.map((line) => ringPath(line, false)).join("");
const scaleKm = frame.widthKm > 6 ? 2 : 1;
const clipId = `map-clip-${Math.abs(Math.round(frame.north * 1e5 + frame.west * 1e3))}`;
---

<div
  class:list={["map", className]}
  style={`--map-aspect: ${width} / ${height}`}
  data-map
  data-north={frame.north}
  data-west={frame.west}
  data-width-km={frame.widthKm}
  data-height-km={frame.heightKm}
>
  <svg
    class="map__base"
    viewBox={`0 0 ${width} ${height}`}
    role="img"
    aria-label={label}
    focusable="false"
  >
    <defs>
      <clipPath id={clipId}><rect width={width} height={height}></rect></clipPath>
    </defs>
    <g clip-path={`url(#${clipId})`}>
      <rect class="map__sea" width={width} height={height}></rect>
      <path class="map__land-shadow" d={land}></path>
      <path class="map__land" d={land}></path>
      <path class="map__runway" d={runway}></path>
    </g>
    <slot name="svg" />
  </svg>
  <slot />
  <span
    class="map__scale"
    aria-hidden="true"
    style={`--scale: ${((scaleKm * UNITS_PER_KM) / width) * 100}%`}
  >
    <span class="map__scale-bar"></span>
    {scaleKm} km
  </span>
  <span class="map__credit">© OpenStreetMap contributors</span>
</div>
