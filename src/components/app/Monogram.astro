---
/**
 * A small architectural signature drawn from the Ocean Pavilion's nested
 * timber A-frames. The baseline and supports keep it distinct from a play icon.
 */
interface Props {
  size?: "sm" | "md";
}
const { size = "md" } = Astro.props;
---

<span class:list={["monogram", `monogram--${size}`]} aria-hidden="true">
  <svg class="monogram__pavilion" viewBox="0 0 40 40" fill="none" focusable="false">
    <path d="M7.5 29.5 20 9l12.5 20.5"></path>
    <path d="M12.5 29.5 20 16l7.5 13.5"></path>
    <path d="M15.5 29.5V23M24.5 29.5V23M8 30.5h24"></path>
  </svg>
</span>
