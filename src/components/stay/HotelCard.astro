---
/**
 * One hotel. The card and its map pin are one state (Akari IP-03): pointing
 * at, focusing, pressing "Show on map" or centring the card on a phone makes
 * it the active hotel, and the map answers with its pin and drive line.
 */
import Picture from "../app/Picture.astro";
import Icon from "../app/Icon.astro";
import ExternalLink from "../app/ExternalLink.astro";
import type { Stay } from "../../data/travel";

interface Props {
  stay: Stay;
  venueQuery: string;
  index: number;
}

const { stay, venueQuery, index } = Astro.props;
const maps = (q: string) =>
  `https://www.google.com/maps/search/?api=1&query=${encodeURIComponent(q)}`;
const directions = (from: string, to: string) =>
  `https://www.google.com/maps/dir/?api=1&origin=${encodeURIComponent(from)}&destination=${encodeURIComponent(to)}&travelmode=driving`;
const distance = stay.toVenue
  ? stay.toVenue.km < 1
    ? `${Math.round(stay.toVenue.km * 1000)} m`
    : `${stay.toVenue.km} km`
  : null;
---

<li
  class:list={["hotel", stay.isVenue && "hotel--venue"]}
  id={`stay-${stay.id}`}
  data-hotel={stay.id}
  data-distance={stay.toVenue?.km ?? 0}
  data-price={stay.priceFrom}
  data-order={index}
  style={`--order: ${index}`}
  aria-labelledby={`hotel-name-${stay.id}`}
>
  <div class="hotel__media">
    <Picture
      image={stay.image}
      sizes="(min-width: 1360px) 360px, (min-width: 1024px) 34vw, 86vw"
      class="hotel__img"
    />
    <span class:list={["hotel__badge", stay.isVenue && "hotel__badge--venue"]}>
      {stay.isVenue && <Icon name="pavilion" size={14} />}
      {stay.badge}
    </span>
  </div>

  <div class="hotel__body">
    <div class="hotel__title-row">
      <h3 class="hotel__name" id={`hotel-name-${stay.id}`}>{stay.name}</h3>
      <p class="hotel__price">
        <span class="hotel__price-from">from about</span>
        <span class="hotel__price-value num">£{stay.priceFrom}</span>
        <span class="hotel__price-unit">a night</span>
      </p>
    </div>
    <p class="hotel__kind">{stay.kind}</p>

    <ul class="hotel__chips" aria-label="Getting around">
      <li class:list={["chip", stay.isVenue ? "chip--timber" : "chip--lagoon"]}>
        <Icon name={stay.isVenue ? "pavilion" : "car"} size={14} />
        {
          stay.isVenue
            ? "The wedding is here"
            : stay.toVenue?.minutes
              ? `${stay.toVenue.minutes} min to the wedding`
              : `Next door, ${distance}`
        }
      </li>
      <li class="chip">
        <Icon name="plane" size={14} />
        {stay.fromAirport.minutes} min from the airport
      </li>
    </ul>

    <p class="hotel__desc">{stay.description}</p>
    <p class="hotel__suits"><span>Good for</span> {stay.suits}</p>

    {
      stay.note && (
        <p class="hotel__note">
          <Icon name="sparkle" size={16} />
          {stay.note}
        </p>
      )
    }

    <div class="hotel__actions">
      <ExternalLink href={stay.officialUrl} site={stay.officialSite} variant="secondary">
        Hotel website
      </ExternalLink>
      <button class="hotel__show" type="button" data-show-on-map={stay.id} aria-controls="stay-map">
        <Icon name="map" size={18} />
        Show on map
      </button>
      <ExternalLink
        href={stay.isVenue
          ? directions("Mactan-Cebu International Airport", stay.mapsQuery)
          : directions(stay.mapsQuery, venueQuery)}
        site="google.com/maps"
      >
        {stay.isVenue ? "Directions from the airport" : "Directions to Shangri-La"}
      </ExternalLink>
      <ExternalLink href={maps(stay.mapsQuery)} site="google.com/maps">Google Maps</ExternalLink>
    </div>
    <p class="hotel__credit credit">Photo: {stay.image.credit}</p>
  </div>
</li>
