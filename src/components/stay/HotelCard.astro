---
/**
 * One hotel. The card and its map pin are one state (Akari IP-03): pointing
 * at, focusing, pressing "Show on map" or centring the card on a phone makes
 * it the active hotel, and the map answers: its pin rises, the camera frames
 * it with the venue, and a car drives the line to the Ocean Pavilion.
 *
 * The photograph leads. The card keeps to what decides a choice (price, drive
 * time, what it is); the rest opens in a sheet that grows out of the photo.
 * Without JavaScript the full detail simply shows in the card.
 */
import Picture from "../app/Picture.astro";
import Icon from "../app/Icon.astro";
import ExternalLink from "../app/ExternalLink.astro";
import Credit from "../app/Credit.astro";
import type { Stay } from "../../data/travel";

interface Props {
  stay: Stay;
  venueQuery: string;
  index: number;
}

const { stay, venueQuery, index } = Astro.props;
const maps = (q: string) =>
  `https://www.google.com/maps/search/?api=1&query=${encodeURIComponent(q)}`;
const directions = (from: string, to: string) =>
  `https://www.google.com/maps/dir/?api=1&origin=${encodeURIComponent(from)}&destination=${encodeURIComponent(to)}&travelmode=driving`;
const distance = stay.toVenue
  ? stay.toVenue.km < 1
    ? `${Math.round(stay.toVenue.km * 1000)} m`
    : `${stay.toVenue.km} km`
  : null;
const drive = stay.isVenue
  ? "The wedding is here"
  : stay.toVenue?.minutes
    ? `${stay.toVenue.minutes} min to the wedding`
    : `Next door, ${distance}`;
---

<li
  class:list={["hotel", stay.isVenue && "hotel--venue"]}
  id={`stay-${stay.id}`}
  data-hotel={stay.id}
  data-distance={stay.toVenue?.km ?? 0}
  data-price={stay.priceFrom}
  data-order={index}
  aria-labelledby={`hotel-name-${stay.id}`}
>
  <article class="hotel__card">
    <div class="hotel__media">
      <Picture image={stay.image} sizes="(min-width: 1024px) 520px, 84vw" class="hotel__img" />
      <span class="hotel__rank num" data-rank aria-hidden="true">{index + 1}</span>
      <span class:list={["hotel__badge", stay.isVenue && "hotel__badge--venue"]}>
        {stay.isVenue && <Icon name="pavilion" size={14} />}
        {stay.badge}
      </span>
      <p class="hotel__price">
        <span class="hotel__price-from">from about</span>
        <b class="num">£{stay.priceFrom}</b>
        <span class="hotel__price-from">a night</span>
      </p>
    </div>

    <div class="hotel__body">
      <h3 class="hotel__name" id={`hotel-name-${stay.id}`}>{stay.name}</h3>
      <p class="hotel__kind">{stay.kind}</p>
      <ul class="hotel__drive" aria-label="Getting around">
        <li class:list={[stay.isVenue && "is-venue"]}>
          <Icon name={stay.isVenue ? "pavilion" : "car"} size={16} />
          {drive}
        </li>
        <li>
          <Icon name="plane" size={16} />
          {stay.fromAirport.minutes} min from the airport
        </li>
      </ul>

      <div class="hotel__more" data-more>
        <p class="hotel__desc">{stay.description}</p>
        <p class="hotel__suits"><b>Good for</b> {stay.suits}</p>
        {
          stay.note && (
            <p class="hotel__note">
              <Icon name="sparkle" size={16} />
              {stay.note}
            </p>
          )
        }
        <div class="hotel__actions">
          <ExternalLink href={stay.officialUrl} site={stay.officialSite} variant="primary">
            {stay.officialLabel ?? "Hotel website"}
          </ExternalLink>
          <ExternalLink
            href={stay.isVenue
              ? directions("Mactan-Cebu International Airport", stay.mapsQuery)
              : directions(stay.mapsQuery, venueQuery)}
            site="google.com/maps"
          >
            {stay.isVenue ? "Directions from the airport" : "Directions to Shangri-La"}
          </ExternalLink>
          <ExternalLink href={maps(stay.mapsQuery)} site="google.com/maps">Google Maps</ExternalLink
          >
        </div>
        <Credit image={stay.image} class="hotel__credit" />
      </div>

      <div class="hotel__cta">
        <button class="hotel__details" type="button" data-details={stay.id} aria-haspopup="dialog">
          More about {stay.shortName}
          <Icon name="arrow-right" size={16} />
        </button>
        <button
          class="hotel__show"
          type="button"
          data-show-on-map={stay.id}
          aria-controls="stay-map"
        >
          <Icon name="map" size={17} />
          <span class="visually-hidden">Show {stay.shortName} </span>On the map
        </button>
      </div>
    </div>
  </article>
</li>
