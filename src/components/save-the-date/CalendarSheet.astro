---
import { wedding } from "../../config/wedding";
import { googleCalendarUrl } from "../../lib/calendar";

const base = import.meta.env.BASE_URL;
const icsHref = `${base}${wedding.calendar.fileName}`;

/**
 * Google opens a populated web event. Apple and Outlook both take the generated
 * .ics, which is the behaviour that can actually be verified from here; the
 * Outlook web deeplink could not be confirmed end to end without an account.
 */
const providers = [
  {
    name: "Google Calendar",
    icon: "google-calendar.svg",
    href: googleCalendarUrl(),
    cue: "↗",
    external: true,
  },
  { name: "Apple Calendar", icon: "apple.svg", href: icsHref, cue: "↓", external: false },
  { name: "Microsoft Outlook", icon: "outlook.svg", href: icsHref, cue: "↓", external: false },
];
---

<div class="sheet-layer" id="calendar-enclosure" data-sheet-layer>
  <a class="sheet-scrim" href="#" tabindex="-1" aria-hidden="true" data-sheet-close></a>
  <section
    class="sheet"
    role="dialog"
    aria-labelledby="calendar-enclosure-title"
    tabindex="-1"
    data-sheet
  >
    <div class="sheet__grip" aria-hidden="true"></div>
    <div class="sheet__header">
      <h2 class="sheet__title" id="calendar-enclosure-title">Save The Date</h2>
      <button
        class="sheet__close"
        type="button"
        aria-label="Close calendar options"
        data-sheet-close
      >
        <span aria-hidden="true">×</span>
      </button>
    </div>
    <ul class="sheet__providers">
      {
        providers.map((provider) => (
          <li>
            <a
              class="provider"
              href={provider.href}
              target={provider.external ? "_blank" : undefined}
              rel={provider.external ? "noopener noreferrer" : undefined}
              download={provider.external ? undefined : true}
            >
              <img
                class="provider__icon"
                src={`${base}provider-assets/${provider.icon}`}
                alt=""
                width="28"
                height="28"
              />
              <span class="provider__name">{provider.name}</span>
              <span class="provider__cue" aria-hidden="true">
                {provider.cue}
              </span>
            </a>
          </li>
        ))
      }
    </ul>
  </section>
</div>
