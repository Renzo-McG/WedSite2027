---
import StageVisual from "./StageVisual.astro";
import InvitationContent from "./InvitationContent.astro";
import OpeningCover from "./OpeningCover.astro";
import CalendarSheet from "./CalendarSheet.astro";
---

<div class="std" data-std>
  <StageVisual />

  <!-- The markup ships in the `composed` state, so the whole invitation is
       readable when JavaScript never runs. -->
  <article class="invitation" data-phase="composed" data-invitation>
    <div class="invitation__surface">
      <div class="invitation__grain" aria-hidden="true"></div>
      <InvitationContent />
    </div>

    <OpeningCover />
    <CalendarSheet />
  </article>

  {
    /* State control only — it closes the invitation, it is not browser
      navigation. It sits outside the card so it never joins the wedding copy. */
  }
  <button class="back" type="button" data-replay aria-label="Close invitation" hidden>
    <svg viewBox="0 0 24 24" aria-hidden="true" focusable="false">
      <path d="M14.5 5.5 8 12l6.5 6.5" fill="none" stroke="currentColor" stroke-width="1.4"></path>
    </svg>
    <span class="back__label" aria-hidden="true">Close</span>
  </button>
</div>

<!-- Every navigation begins with the invitation sealed. The composed markup
     remains available when JavaScript is disabled. -->
<script is:inline>
  (function () {
    const root = document.querySelector("[data-invitation]");
    root?.setAttribute("data-phase", "sealed");
  })();
</script>

<script>
  import "../../scripts/save-the-date";
</script>
