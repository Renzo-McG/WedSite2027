---
import StageVisual from "./StageVisual.astro";
import InvitationContent from "./InvitationContent.astro";
import OpeningCover from "./OpeningCover.astro";
import CalendarSheet from "./CalendarSheet.astro";
---

<div class="std" data-std>
  <StageVisual />

  <!-- The markup ships in the `composed` state, so the whole invitation is
       readable when JavaScript never runs. -->
  <article class="invitation" data-phase="composed" data-invitation>
    <div class="invitation__surface">
      <div class="invitation__grain" aria-hidden="true"></div>
      <div class="invitation__leaf" aria-hidden="true"></div>
      <InvitationContent />
    </div>

    <OpeningCover />
    <CalendarSheet />
  </article>
</div>

<!-- Runs before first paint so returning visitors never see the closed state
     flash, and first-time visitors never see the open one. -->
<script is:inline>
  (function () {
    const root = document.querySelector("[data-invitation]");
    if (!root) return;
    let opened = false;
    try {
      opened = window.localStorage.getItem("eandl.save-the-date.v1") === "opened";
    } catch {
      /* Blocked storage simply replays the opening next visit. */
    }
    root.setAttribute("data-phase", opened ? "composed" : "closed");
  })();
</script>

<script>
  import "../../scripts/save-the-date";
</script>
