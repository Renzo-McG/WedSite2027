---
import { wedding } from "../../config/wedding";
import Countdown from "./Countdown.astro";
import { routeHref, routes } from "../../config/routes";

const websiteHref = routeHref(import.meta.env.BASE_URL, routes.home);
// "Sunday, 24 October 2027": the date itself never breaks, so a narrow screen
// wraps after the weekday rather than leaving the year on its own line.
const [weekday = "", ...dateParts] = wedding.date.display.split(", ");
const dayMonthYear = dateParts.join(", ");
---

<div class="invitation__content">
  <header class="invitation__header">
    <p class="label">{wedding.cue}</p>
  </header>

  <main class="invitation__main">
    <h1 class="names names--lockup">
      <span class="names__line">{wedding.couple.first}</span>
      <span class="names__line names__line--second">
        <span class="names__amp">&amp;</span>{" "}{wedding.couple.second}
      </span>
    </h1>
    <div class="details">
      <p class="details__date">
        {
          dayMonthYear ? (
            <>
              {weekday}, <span class="details__date-day">{dayMonthYear}</span>
            </>
          ) : (
            weekday
          )
        }
      </p>
      <p class="details__place">
        {wedding.venue}<br />{wedding.location}
      </p>
    </div>
  </main>

  {
    /* Bounded breathing space: the only flexible row, so the composition can
      never open an accidental void. */
  }
  <div class="invitation__breath" aria-hidden="true"></div>

  <footer class="invitation__footer">
    <Countdown />
    <div class="invitation__actions">
      <a class="cta" href="#calendar-enclosure" data-sheet-open>
        <span>Save to Calendar</span>
        <span class="cta__icon" aria-hidden="true">
          <svg viewBox="0 0 20 20" fill="none" focusable="false">
            <rect x="2.5" y="4.5" width="15" height="13" rx="2"></rect>
            <path d="M2.5 8h15M6.5 2.5v4M13.5 2.5v4M6.5 11.5h2M11.5 11.5h2"></path>
          </svg>
        </span>
      </a>
      <a class="website-link" href={websiteHref}>
        Explore our website <span class="website-link__arrow" aria-hidden="true">→</span>
      </a>
    </div>
    <p class="note">{wedding.note}</p>
  </footer>
</div>
