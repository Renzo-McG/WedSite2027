---
import { wedding } from "../../config/wedding";

/**
 * The stage is painted as a background rather than an <img>, so a missing or
 * failed asset degrades to the gradient stage silently instead of leaving a
 * broken-image icon on the page.
 */
const stageImage = `${import.meta.env.BASE_URL}${wedding.stage.image}`;
const videoConfig = JSON.stringify(wedding.stage.videos);
---

<div
  class="stage"
  aria-hidden="true"
  data-stage
  data-stage-base={import.meta.env.BASE_URL}
  data-stage-fallback={stageImage}
  data-stage-videos={videoConfig}
>
  <div class="stage__image" data-stage-fallback-layer></div>
  <noscript>
    <div class="stage__noscript" style={`background-image: url("${stageImage}")`}></div>
  </noscript>
  <!-- `metadata` only: the venue film is ~10 MB and must never compete with
       first paint. The poster is the film's own first frame, so the handoff
       into playback is invisible even if buffering costs a moment. -->
  <video
    class="stage__video"
    muted
    playsinline
    preload="metadata"
    tabindex="-1"
    data-stage-video
    disablepictureinpicture></video>
  <span class="stage__wash"></span>
  <span class="stage__glow"></span>
</div>
