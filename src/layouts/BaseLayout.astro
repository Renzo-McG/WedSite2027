---
import { canonicalPageUrl } from "../config/site";

interface Props {
  title: string;
  description: string;
  noindex?: boolean;
  className?: string;
  themeColor?: string;
  /** Off for pages with no address of their own, such as the 404. */
  canonical?: boolean;
}

const {
  title,
  description,
  noindex = false,
  className = "",
  themeColor,
  canonical: hasCanonical = true,
} = Astro.props;
const canonical = hasCanonical ? canonicalPageUrl(Astro.url.pathname) : undefined;
---

<!doctype html>
<html lang="en-GB">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
    <meta name="description" content={description} />
    {noindex && <meta name="robots" content="noindex, nofollow" />}
    {themeColor && <meta name="theme-color" content={themeColor} />}
    <meta property="og:type" content="website" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    {canonical && <meta property="og:url" content={canonical} />}
    <meta name="twitter:card" content="summary" />
    {canonical && <link rel="canonical" href={canonical} />}
    <link rel="icon" href={`${import.meta.env.BASE_URL}favicon.svg`} type="image/svg+xml" />
    <link
      rel="icon"
      href={`${import.meta.env.BASE_URL}favicon-32.png`}
      type="image/png"
      sizes="32x32"
    />
    <link rel="apple-touch-icon" href={`${import.meta.env.BASE_URL}apple-touch-icon.png`} />
    <title>{title}</title>
    <slot name="head" />
  </head>
  <body class={className}>
    <slot />
  </body>
</html>
