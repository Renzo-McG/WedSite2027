---
import BaseLayout from "../layouts/BaseLayout.astro";
import SaveTheDateExperience from "../components/save-the-date/SaveTheDateExperience.astro";
import { wedding } from "../config/wedding";
import plusJakartaFont from "../assets/fonts/plus-jakarta-sans-latin.woff2?url";
import { DEFAULT_DISPLAY_FONT, DISPLAY_FONT_IDS } from "../lib/display-font";
import "../styles/fonts.css";
import "../styles/save-the-date.tokens.css";
import "../styles/save-the-date.css";

const title = `${wedding.couple.first} & ${wedding.couple.second} — Save the Date`;
const description = `${wedding.date.display} · ${wedding.venue}, ${wedding.location}`;
---

<BaseLayout
  title={title}
  description={description}
  noindex
  themeColor="#0d1512"
  className="std-page"
>
  <Fragment slot="head">
    <script
      is:inline
      define:vars={{ displayFontIds: DISPLAY_FONT_IDS, defaultDisplayFont: DEFAULT_DISPLAY_FONT }}
    >
      (function () {
        const value = new URLSearchParams(window.location.search).get("type");
        document.documentElement.dataset.displayType = displayFontIds.includes(value)
          ? value
          : defaultDisplayFont;
      })();
    </script>
    <link rel="preload" href={plusJakartaFont} as="font" type="font/woff2" crossorigin />
  </Fragment>
  <SaveTheDateExperience />
</BaseLayout>
