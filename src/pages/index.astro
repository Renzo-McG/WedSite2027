---
import BaseLayout from "../layouts/BaseLayout.astro";
import SaveTheDateExperience from "../components/save-the-date/SaveTheDateExperience.astro";
import { wedding } from "../config/wedding";
import serifFont from "../assets/fonts/instrument-serif-400-latin.woff2?url";
import sansFont from "../assets/fonts/manrope-400-600-latin.woff2?url";
import "../styles/fonts.css";
import "../styles/save-the-date.tokens.css";
import "../styles/save-the-date.css";

const title = `${wedding.couple.first} & ${wedding.couple.second} — Save the Date`;
const description = `${wedding.date.display} · ${wedding.venue}, ${wedding.location}`;
const stageImage = `${import.meta.env.BASE_URL}${wedding.stage.image}`;
---

<BaseLayout
  title={title}
  description={description}
  noindex
  themeColor="#0d1512"
  className="std-page"
>
  <Fragment slot="head">
    <link rel="preload" href={serifFont} as="font" type="font/woff2" crossorigin />
    <link rel="preload" href={sansFont} as="font" type="font/woff2" crossorigin />
    <link rel="preload" href={stageImage} as="image" type="image/webp" />
  </Fragment>
  <SaveTheDateExperience />
</BaseLayout>
