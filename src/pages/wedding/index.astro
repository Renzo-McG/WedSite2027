---
/**
 * The wedding: the reason for the journey, and the emotional anchor of the
 * companion. Warmer than the travel screens (timber, sunset), still the same
 * product. Some of it waits on plans being confirmed, and says so plainly.
 *
 * The Pavilion photograph arrives from the Home door (a morph), the A-frame
 * roof line draws itself over the date, and as the screen scrolls the light
 * turns to golden hour (scripts/app/wedding.ts).
 */
import AppShell from "../../layouts/AppShell.astro";
import Icon from "../../components/app/Icon.astro";
import Picture from "../../components/app/Picture.astro";
import Credit from "../../components/app/Credit.astro";
import ExternalLink from "../../components/app/ExternalLink.astro";
import WeddingWindow from "../../components/trip/WeddingWindow.astro";
import { venueImages, weddingToCome } from "../../data/site";
import { arrival } from "../../data/travel";
import { wedding } from "../../config/wedding";
import { googleCalendarUrl } from "../../lib/calendar";
import "../../styles/screen-wedding.css";

const base = import.meta.env.BASE_URL;
const ics = `${base}${wedding.calendar.fileName}`;
const hero = venueImages.pavilion;
const heroSizes = "(min-width: 1024px) calc(100vw - 248px), 100vw";
const venueMap = `https://www.google.com/maps/search/?api=1&query=${encodeURIComponent("Shangri-La Mactan, Cebu")}`;
---

<AppShell
  screen="wedding"
  immersive
  title="The wedding — Emily & Lawrence"
  description="Emily and Lawrence's wedding: Sunday 24 October 2027 at the Ocean Pavilion, Shangri-La Mactan, Cebu, Philippines."
  preload={[
    {
      srcset: hero.widths.map((w) => `${base}assets/guide/${hero.name}-${w}.webp ${w}w`).join(", "),
      sizes: heroSizes,
    },
  ]}
>
  <section class="vow" data-vow aria-labelledby="vow-title">
    <div class="vow__media">
      <Picture image={hero} sizes={heroSizes} class="vow__img" priority morph="pavilion" />
      <span class="vow__light" aria-hidden="true"></span>
    </div>
    <div class="vow__body">
      <svg class="vow__roof" viewBox="0 0 120 44" aria-hidden="true" focusable="false">
        <path d="M4 42 60 4l56 38" pathLength="1"></path>
        <path d="M60 4 36 42M60 4l24 38" pathLength="1"></path>
      </svg>
      <p class="vow__day">Sunday</p>
      <h1 class="vow__date" id="vow-title" data-large-title>
        <span class="vow__line"><span>24 October</span></span>
        <span class="vow__line"><span>2027</span></span>
      </h1>
      <p class="vow__place">The Ocean Pavilion, Shangri-La Mactan, Cebu</p>
      <p class="vow__count" data-countdown hidden>
        <b class="num" data-countdown-days></b> days to go
      </p>
    </div>
    <Credit image={hero} class="photo-credit vow__credit" />
  </section>

  <section class="wed-section" aria-labelledby="weekend-title">
    <h2 class="section-title" id="weekend-title">Around the day</h2>
    <WeddingWindow details={{ wedding: "At the Ocean Pavilion" }} />
    <p class="wed-section__note">
      We may also plan something simple around the day itself. It's completely optional and still to
      be confirmed; we'll share anything we arrange here once we know more.
    </p>
  </section>

  <section class="venue" aria-labelledby="venue-title">
    <figure class="venue__media">
      <Picture
        image={venueImages.interior}
        sizes="(min-width: 1024px) 45vw, 100vw"
        class="venue__img"
      />
      <Credit image={venueImages.interior} class="photo-credit" />
    </figure>
    <div class="venue__body">
      <h2 class="section-title" id="venue-title">The Ocean Pavilion</h2>
      <p class="venue__text">
        A tall timber and glass A-frame at the water's edge at {wedding.venue}, looking out to sea.
        It's on the east coast of Mactan, about {arrival.toVenue.km} km from the airport.
      </p>
      <ul class="venue__links">
        <li>
          <a class="venue__link" href={`${base}stay/`}>
            <Icon name="bed" size={18} />
            Where to stay nearby
            <Icon name="arrow-right" size={16} />
          </a>
        </li>
        <li>
          <a class="venue__link" href={`${base}travel/#arriving`}>
            <Icon name="car" size={18} />
            From the airport
            <Icon name="arrow-right" size={16} />
          </a>
        </li>
      </ul>
      <ExternalLink href={venueMap} site="google.com/maps">Open in Google Maps</ExternalLink>
    </div>
  </section>

  <section class="keep" aria-labelledby="keep-title">
    <div class="keep__head">
      <h2 class="section-title" id="keep-title">Keep the date</h2>
      <p class="keep__lead">{wedding.note}. Until then, add the day to your calendar.</p>
    </div>
    <ul class="providers">
      <li>
        <a class="provider" href={googleCalendarUrl()} target="_blank" rel="noopener noreferrer">
          <img src={`${base}provider-assets/google-calendar.svg`} alt="" width="28" height="28" />
          <span>Google Calendar</span>
          <Icon name="arrow-out" size={16} />
          <span class="visually-hidden">(opens google.com in a new tab)</span>
        </a>
      </li>
      <li>
        <a class="provider" href={ics} download>
          <img src={`${base}provider-assets/apple.svg`} alt="" width="28" height="28" />
          <span>Apple Calendar</span>
          <span class="provider__cue">.ics</span>
        </a>
      </li>
      <li>
        <a class="provider" href={ics} download>
          <img src={`${base}provider-assets/outlook.svg`} alt="" width="28" height="28" />
          <span>Outlook</span>
          <span class="provider__cue">.ics</span>
        </a>
      </li>
    </ul>
  </section>

  <section class="next" aria-labelledby="next-title">
    <h2 class="section-title" id="next-title">Still to come, here</h2>
    <p class="next__lead">As plans are confirmed, this is where you'll find:</p>
    <ul class="next__list">
      {
        weddingToCome.map((item, i) => (
          <li class="next__item" style={`--i: ${i}`}>
            <span class="next__icon">
              <Icon name={item.icon} size={20} />
            </span>
            <span class="next__text">
              <span class="next__label">{item.label}</span>
              <span class="next__detail">{item.detail}</span>
            </span>
          </li>
        ))
      }
    </ul>
    {
      /* This lands on the already-opened invitation rather than replaying the
        opening film, because save-the-date.ts remembers in localStorage that
        it has been opened. Fixing it properly means teaching `/` an explicit
        replay signal, which belongs to the Save the Date integration pass;
        see "Known, deliberately deferred" in docs/TRAVEL_AND_STAY.md. */
    }
    <a class="next__std" href={base}>
      <Icon name="chevron-left" size={16} />
      See the Save the Date again
    </a>
  </section>

  <script>
    import "../../scripts/app/window";
    import "../../scripts/app/wedding";
  </script>
</AppShell>
