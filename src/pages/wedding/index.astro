---
import AppShell from "../../layouts/AppShell.astro";
import ScreenHeader from "../../components/app/ScreenHeader.astro";
import Icon from "../../components/app/Icon.astro";
import Picture from "../../components/app/Picture.astro";
import Credit from "../../components/app/Credit.astro";
import ExternalLink from "../../components/app/ExternalLink.astro";
import { readiness, venueImages } from "../../data/site";
import { wedding } from "../../config/wedding";
import { googleCalendarUrl } from "../../lib/calendar";

const base = import.meta.env.BASE_URL;
const ics = `${base}${wedding.calendar.fileName}`;
const hero = venueImages.pavilion;
const heroSizes = "(min-width: 1024px) calc(100vw - 360px), 100vw";
const coming = readiness.filter((item) => item.state === "soon");
const venueMap = `https://www.google.com/maps/search/?api=1&query=${encodeURIComponent("Shangri-La Mactan, Cebu")}`;
---

<AppShell
  screen="wedding"
  title="The wedding — Emily & Lawrence"
  description="Emily and Lawrence's wedding: Sunday 24 October 2027 at Shangri-La Mactan, Cebu, Philippines."
  preload={[
    {
      srcset: hero.widths.map((w) => `${base}assets/guide/${hero.name}-${w}.webp ${w}w`).join(", "),
      sizes: heroSizes,
    },
  ]}
>
  <ScreenHeader title="The wedding" lead="What we can tell you now, and how to keep the date." />

  <figure class="wedding-hero">
    <Picture image={hero} sizes={heroSizes} class="wedding-hero__img" priority />
    <figcaption class="wedding-hero__cap">
      <span>The Ocean Pavilion, Shangri-La Mactan</span>
      <Credit image={hero} />
    </figcaption>
  </figure>

  <div class="wedding-grid">
    <section class="card facts" aria-labelledby="facts-title">
      <h2 class="card__title" id="facts-title">The essentials</h2>
      <dl class="facts__list">
        <div class="facts__row">
          <dt><Icon name="calendar" size={20} /> Date</dt>
          <dd>{wedding.date.display}</dd>
        </div>
        <div class="facts__row">
          <dt><Icon name="pavilion" size={20} /> Venue</dt>
          <dd>
            {wedding.venue}, {wedding.location}
            <ExternalLink href={venueMap} site="google.com/maps">Open in Google Maps</ExternalLink>
          </dd>
        </div>
        <div class="facts__row" data-countdown hidden>
          <dt><Icon name="clock" size={20} /> To go</dt>
          <dd><span class="num" data-countdown-days></span> days</dd>
        </div>
        <div class="facts__row">
          <dt><Icon name="info" size={20} /> Invitation</dt>
          <dd>{wedding.note}</dd>
        </div>
      </dl>
    </section>

    <section class="card calendar-card" aria-labelledby="cal-title">
      <h2 class="card__title" id="cal-title">Add it to your calendar</h2>
      <ul class="providers">
        <li>
          <a class="provider" href={googleCalendarUrl()} target="_blank" rel="noopener noreferrer">
            <img src={`${base}provider-assets/google-calendar.svg`} alt="" width="28" height="28" />
            <span>Google Calendar</span>
            <Icon name="arrow-out" size={16} />
            <span class="visually-hidden">(opens google.com in a new tab)</span>
          </a>
        </li>
        <li>
          <a class="provider" href={ics} download>
            <img src={`${base}provider-assets/apple.svg`} alt="" width="28" height="28" />
            <span>Apple Calendar</span>
            <span class="provider__cue">.ics</span>
          </a>
        </li>
        <li>
          <a class="provider" href={ics} download>
            <img src={`${base}provider-assets/outlook.svg`} alt="" width="28" height="28" />
            <span>Microsoft Outlook</span>
            <span class="provider__cue">.ics</span>
          </a>
        </li>
      </ul>
    </section>
  </div>

  <section class="card coming" aria-labelledby="coming-title">
    <div class="coming__media">
      <Picture
        image={venueImages.interior}
        sizes="(min-width: 1024px) 40vw, 100vw"
        class="coming__img"
      />
    </div>
    <div class="coming__body">
      <h2 class="card__title" id="coming-title">More to come</h2>
      <p class="note">We'll add these here as plans are confirmed.</p>
      <ul class="coming__list">
        {
          coming.map((item) => (
            <li>
              <span class="coming__label">{item.label}</span>
              <span class="coming__detail">{item.detail}</span>
            </li>
          ))
        }
      </ul>
      <a class="button button--ghost" href={base}>
        <Icon name="chevron-left" size={18} />
        See the Save the Date
      </a>
      <Credit image={venueImages.interior} />
    </div>
  </section>
</AppShell>
