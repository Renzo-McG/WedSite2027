---
/**
 * Your trip: the wedding day first, with whatever we may arrange either side
 * of it, then the holiday around it, as inspiration.
 */
import AppShell from "../../layouts/AppShell.astro";
import ScreenHeader from "../../components/app/ScreenHeader.astro";
import WeddingWindow from "../../components/trip/WeddingWindow.astro";
import HolidayExplorer from "../../components/trip/HolidayExplorer.astro";
import { tripGuidance } from "../../data/travel";
import "../../styles/screen-trip.css";
---

<AppShell
  screen="trip"
  title="Your trip — Emily & Lawrence"
  description="The days to keep for Emily and Lawrence's wedding in Cebu, and ideas for making a holiday of it: what 7, 10 or 14 days in the Philippines make room for."
>
  <ScreenHeader title="Your trip">
    <p class="trip-ask">
      The wedding is on <b>Sunday 24 October</b>. Everything around it is yours.
    </p>
  </ScreenHeader>

  <section class="trip-window" aria-label="The wedding window">
    <WeddingWindow />
    <p class="trip-window__note">{tripGuidance.window}</p>
  </section>

  <HolidayExplorer />

  <script>
    import "../../scripts/app/trip";
  </script>
</AppShell>
